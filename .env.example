# Neural Core / StudentIoT3 - Local configuration placeholders
# IMPORTANT: This is a static GitHub Pages-compatible project. The browser app uses
# public/publishable Supabase credentials only. Never put service_role or secret keys here.

# Supabase (public/publishable values only)
SUPABASE_URL=https://bbnvfbjkzjexcfyprkbl.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_or_anon_key

# Device / data contract (must match existing schema)
DEVICE_NAME=ESP32-01
SENSOR_TYPES=temperature,humidity

# App behavior
ONLINE_THRESHOLD_MS=30000
POLL_INTERVAL_MS=15000
UPDATE_MANIFEST_URL=./version.json

# Firmware (DO NOT COMMIT REAL WIFI CREDENTIALS)
WIFI_SSID=YOUR_WIFI_NAME
WIFI_PASSWORD=YOUR_WIFI_PASSWORD
